# ─────────────────────────────────────────────
# 의존성 · 빌드 결과물 (npm install / npm run build로 다시 만들 수 있음)
# ─────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# ─────────────────────────────────────────────
# 환경변수 · 비밀 값 (절대 올리지 않음)
#   Supabase URL·키는 .env.local에 두고, Vercel에는 Environment Variables로 등록합니다.
#   빈 양식인 .env.example만 올립니다.
# ─────────────────────────────────────────────
.env
.env.*
!.env.example

# ─────────────────────────────────────────────
# 배포 · DB 도구가 만드는 로컬 폴더
# ─────────────────────────────────────────────
.vercel/
supabase/.temp/
supabase/.branches/

# ─────────────────────────────────────────────
# 캐시 · 로그
# ─────────────────────────────────────────────
.vite/
.cache/
.eslintcache
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────────────────────────────────────
# 개인 도구 설정 (Claude 앱, 에디터)
# ─────────────────────────────────────────────
.claude/
.vscode/
.idea/
*.swp
*.suo

# ─────────────────────────────────────────────
# 운영체제가 만드는 파일
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

.vercel
